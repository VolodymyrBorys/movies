# Template. COPY (don't move) to observability/.env (gitignored) and fill in:
#   cp observability/env.example observability/.env
# Read by docker compose for variable substitution in observability/compose.yml
# (always pass --env-file observability/.env).

GRAFANA_ADMIN_PASSWORD=

# postgres_exporter → PostgreSQL on the host, as the monitoring role:
#   CREATE ROLE movies_monitor LOGIN PASSWORD '...';
#   GRANT pg_monitor TO movies_monitor;
# Same database name as PG_DATABASE in the app's .env (required, no default).
PG_EXPORTER_DATABASE=
PG_EXPORTER_USER=movies_monitor
PG_EXPORTER_PASSWORD=
PG_EXPORTER_PORT=5432
PG_EXPORTER_SSLMODE=disable

# redis_exporter → Redis on the host (leave empty if Redis has no ACL/password)
REDIS_EXPORTER_PORT=6379
REDIS_EXPORTER_USER=
REDIS_EXPORTER_PASSWORD=
