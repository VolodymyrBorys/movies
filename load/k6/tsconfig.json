{
  // Type checking for the k6 scenarios: `npx tsc -p load/k6`.
  // Same strictness as the app (extends the root), but k6 is not Node: no @types/node,
  // only k6's globals (__ENV, open, ...) and modules (k6/http, k6/execution, ...).
  // k6 itself runs the .ts files directly (strips types); this config only checks them.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["k6"],
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["./**/*.ts"],
  // Override: the root's exclude contains "load" and would be inherited.
  "exclude": []
}
